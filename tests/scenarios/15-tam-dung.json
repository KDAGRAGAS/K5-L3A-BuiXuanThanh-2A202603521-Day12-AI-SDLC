{
  "requirement": "Pause giữ nguyên simulation tick và đồng hồ, ghi snapshot paused, resume theo cạnh lên",
  "night": 1,
  "seed": 15,
  "ticks": 5,
  "scenario": { "random_motes": false, "random_shades": false, "motes": [], "shades": [], "time_left_s": 10 },
  "inputs": { "frames": [
    { "tick": 0, "pause": true },
    { "tick": 1, "pause": false },
    { "tick": 2, "pause": true },
    { "tick": 3, "pause": false }
  ] },
  "expect": {
    "events": [[1, "paused", {}], [3, "resumed", {}]],
    "snapshot": [1, "state", "paused"],
    "snapshot_fields": { "sim_tick": 2, "time_left_s": 9.967 }
  },
  "snapshot_every": 1
}
